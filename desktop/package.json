{
  "dependencies": {
    "@openai/codex": "0.154.0"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "name": "paperlume-desktop",
  "version": "0.11.0",
  "private": true,
  "description": "PaperLume desktop paper reader with personal ChatGPT authentication",
  "main": "main.cjs",
  "author": "PaperLume",
  "scripts": {
    "prepare:web": "node prepare.cjs",
    "start": "node prepare.cjs && electron .",
    "test": "node --test test.cjs login.test.cjs google-account.test.cjs pdf-download.test.cjs",
    "pack": "node prepare.cjs && electron-builder --dir",
    "dist": "node prepare.cjs && electron-builder",
    "test:window": "node prepare.cjs && electron test-window.cjs"
  },
  "build": {
    "appId": "io.github.guanbochen0622.openscite",
    "productName": "PaperLume",
    "asar": false,
    "files": [
      "*.cjs",
      "ui.js",
      "web/**/*",
      "!test.cjs",
      "!prepare.cjs",
      "!test-*.cjs",
      "!fixture.cjs",
      "!*.test.cjs"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "PaperLume-${version}-windows-${arch}-setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "category": "public.app-category.education",
      "artifactName": "PaperLume-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
